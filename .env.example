# --- Azure AI Foundry (OpenAI-compatible v1 endpoint) ---
# https://<resource>.openai.azure.com/openai/v1/  or  https://<resource>.services.ai.azure.com/openai/v1/
FOUNDRY_ENDPOINT=
# Deployment name of a model with strong tool calling
FOUNDRY_MODEL=gpt-6.1-sol
# Optional. Leave empty to use Entra ID (az login locally, managed identity in Azure).
FOUNDRY_API_KEY=

# --- Browser ---
HEADLESS=false
# Empty = bundled Chromium. Or: msedge, chrome
BROWSER_CHANNEL=
# Connect to a remote Playwright browser server instead of launching locally, e.g. ws://host:3000/
BROWSER_WS_ENDPOINT=

# --- Run limits and output ---
MAX_STEPS=200
RUN_TIMEOUT_MINUTES=15
TRACE=false
RUNS_DIR=runs
REASONING_EFFORT=medium
# Save the exact request and raw response of every model call to llm/ in the run folder (about 0.5-1 MB per run)
LOG_REQUESTS=true

# --- Values referenced by tasks as {{env.NAME}} (never sent to the model) ---
LOGIN_EMAIL=
